{
  "id": "yolo-inference",
  "version": "1.0.0",
  "display_name": "YOLO Inference",
  "category": "detection",
  "icon": "detection",
  "requires_gpu": true,
  "ports": {
    "input": [
      {
        "id": "image_in",
        "alias": "image_frame",
        "ros2_type": "sensor_msgs/Image",
        "label": "Camera Input"
      }
    ],
    "output": [
      {
        "id": "detections_out",
        "alias": "detections",
        "ros2_type": "vision_msgs/Detection2DArray",
        "label": "Detections"
      },
      {
        "id": "annotated_out",
        "alias": "annotated_image",
        "ros2_type": "sensor_msgs/Image",
        "label": "Annotated View",
        "optional": true
      }
    ]
  },
  "supervisor_params": [
    {
      "id": "confidence",
      "type": "float",
      "label": "Confidence threshold",
      "default": 0.5,
      "min": 0.01,
      "max": 1.0
    },
    {
      "id": "model_version",
      "type": "enum",
      "label": "Model version",
      "default": "latest",
      "options": ["latest", "v8n", "v8s", "v8m", "custom"]
    }
  ],
  "engineer_params": [
    {
      "id": "model_path",
      "type": "string",
      "label": "Custom model path (when model_version=custom)",
      "default": "/models/best.pt"
    },
    {
      "id": "device",
      "type": "enum",
      "label": "Inference device",
      "default": "cuda:0",
      "options": ["cuda:0", "cuda:1", "cpu"]
    },
    {
      "id": "iou_threshold",
      "type": "float",
      "label": "NMS IoU threshold",
      "default": 0.45,
      "min": 0.0,
      "max": 1.0
    }
  ]
}
